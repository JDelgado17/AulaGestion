# Plantilla de configuración de la API. Copiar como .env (que no se sube a git
# porque contiene contraseñas) y generar la llave con: php artisan key:generate
# En producción (Render) estas mismas variables se definen en Environment.

# --- Aplicación ---
APP_NAME="AulaGestión API"
# local en desarrollo, production en el servidor
APP_ENV=local
# Llave de cifrado; la genera php artisan key:generate
APP_KEY=
# true muestra errores detallados; en producción siempre false
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Bogota

APP_LOCALE=es
APP_FALLBACK_LOCALE=es

# --- Registros (en Render usar stderr) ---
LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Base de datos MySQL (local: contenedor de docker-compose.yml) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=aula_gestion
DB_USERNAME=aula_user
DB_PASSWORD=aula_password
# Ruta del certificado CA para conectar por SSL (solo producción con Aiven)
MYSQL_ATTR_SSL_CA=

# --- Caché, colas y sesiones ---
CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file

# Minutos de validez del token de sesión de la app (720 = 12 horas)
SANCTUM_EXPIRATION=720

# true carga los usuarios y aulas de demostración al arrancar el contenedor
SEED_DEMO=false
